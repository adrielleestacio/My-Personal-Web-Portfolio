# Contact form delivery (pick one, or leave both empty to fall back to a
# prefilled mailto: link).

# Web3Forms (https://web3forms.com): enter your email there, paste the access
# key they send you. The key is safe to expose — it only lets the form send to
# your address. Set the same variable in Vercel → Settings → Environment Variables.
VITE_CONTACT_ACCESS_KEY=

# Or any endpoint that accepts a JSON POST of {name, email, message, subject}.
VITE_CONTACT_ENDPOINT=
